{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "脑机创新项目医保证据接力簿领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "STATUS_VERIFIED",
        "MAPPING_PROPOSED",
        "HOSPITAL_ADMITTED",
        "CLAIM_SETTLED",
        "IMPACT_REVIEWED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "product_status",
        "service_mapping",
        "regional_trial",
        "claim_record"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "payload_required_by_event": {
    "STATUS_VERIFIED": [
      "authority_ref",
      "scope"
    ],
    "CLAIM_SETTLED": [
      "service_revision",
      "price_revision"
    ],
    "IMPACT_REVIEWED": [
      "affected_period",
      "decision"
    ]
  },
  "additionalProperties": false
}
